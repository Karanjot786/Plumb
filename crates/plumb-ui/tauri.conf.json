{
  "productName": "Plumb",
  "version": "0.1.0",
  "identifier": "dev.plumb.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plumb",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "See what is actually reclaimable on your disk.",
    "longDescription": "Every other disk analyzer tells you what is big. This one tells you what deleting would actually free: hardlinks, APFS clones, sparse files and snapshots all break the naive sum. Nothing is ever deleted - removals go to a staging area with a manifest and a one-command undo.",
    "copyright": "Copyright 2026 Karanjot786. Licensed under Apache-2.0.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      }
    }
  }
}
